# RUN: llc -mtriple=powerpc64-ibm-xbox360 -mcpu=xenon -run-pass=prologepilog -verify-machineinstrs %s -o - | FileCheck %s

--- |
  declare i32 @__CxxFrameHandler(...)
  declare void @may_throw()
  define void @private_spills() personality ptr @__CxxFrameHandler {
  entry:
    invoke void @may_throw() to label %return unwind label %cleanup
  return:
    ret void
  cleanup:
    %pad = cleanuppad within none []
    cleanupret from %pad unwind to caller
  }
  define void @large_private_spills() personality ptr @__CxxFrameHandler !dbg !3 {
  entry:
    invoke void @may_throw() to label %return unwind label %cleanup
  return:
    ret void
  cleanup:
    %pad = cleanuppad within none []
    cleanupret from %pad unwind to caller
  }
  define void @dynamic_private_spills() personality ptr @__CxxFrameHandler {
  entry:
    invoke void @may_throw() to label %return unwind label %cleanup
  return:
    ret void
  cleanup:
    %pad = cleanuppad within none []
    cleanupret from %pad unwind to caller
  }
  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}
  !0 = distinct !DICompileUnit(language: DW_LANG_C_plus_plus, file: !1, producer: "test", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "test.cpp", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "large_private_spills", scope: !1, file: !1, line: 1, type: !4, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !9)
  !4 = !DISubroutineType(types: !5)
  !5 = !{}
  !6 = !DILocalVariable(name: "spill", scope: !3, file: !1, line: 1, type: !7)
  !7 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !8 = !DILocation(line: 1, column: 1, scope: !3)
  !9 = !{!6}
...
---
name: private_spills
tracksRegLiveness: true
hasEHScopes: true
hasEHFunclets: true
frameInfo:
  adjustsStack: true
  hasCalls: true
  maxCallFrameSize: 80
stack:
  - { id: 0, type: default, size: 4, alignment: 4 }
  - { id: 1, type: spill-slot, size: 4, alignment: 4 }
  - { id: 2, type: spill-slot, size: 4, alignment: 4 }
body: |
  bb.0.entry:
    successors: %bb.1, %bb.2
    $r3 = LI 5
    STW killed $r3, 0, %stack.2
    ADJCALLSTACKDOWN 80, 0, implicit-def $r1, implicit $r1
    BL @may_throw, csr_xbox360, implicit-def $lr, implicit $rm
    ADJCALLSTACKUP 80, 0, implicit-def $r1, implicit $r1
    B %bb.1
  bb.1.return:
    BLR8 implicit $lr8, implicit $rm
  bb.2.cleanup (landing-pad, ehfunclet-entry):
    $r3 = LI 7
    STW $r3, 0, %stack.0
    STW killed $r3, 0, %stack.1
    $r3 = LWZ 0, %stack.1
    STW killed $r3, 0, %stack.0
    $r3 = LWZ 0, %stack.2
    XBOX_CLEANUPRET implicit $lr8, implicit $rm

# CHECK: bb.2.cleanup
# CHECK: liveins: $x12
# CHECK: $x31 = frame-setup ADDI8 $x12, -[[SIZE:[0-9]+]]
# CHECK: $x1 = frame-setup STWU8 $x1, -[[PRIVATE:[0-9]+]], $x1
# CHECK: STW $r3, [[LOCAL:[0-9]+]], $x31
# CHECK: STW killed $r3, [[SPILL:[0-9]+]], $x1
# CHECK: $r3 = LWZ [[SPILL]], $x1
# CHECK: STW killed $r3, [[LOCAL]], $x31
# CHECK: $r3 = LWZ {{[0-9]+}}, $x31
# CHECK: $x1 = ADDI8 $x1, [[PRIVATE]]
# CHECK: XBOX_CLEANUPRET
...
---
name: large_private_spills
tracksRegLiveness: true
isSSA: false
hasEHScopes: true
hasEHFunclets: true
frameInfo:
  adjustsStack: true
  hasCalls: true
  maxCallFrameSize: 80
stack:
  - { id: 0, type: default, size: 40000, alignment: 16 }
  - { id: 1, type: spill-slot, size: 16, alignment: 16 }
  - { id: 2, type: spill-slot, size: 4, alignment: 4 }
body: |
  bb.0.entry:
    successors: %bb.1, %bb.2
    $r3 = LI 5
    STW killed $r3, 0, %stack.2
    ADJCALLSTACKDOWN 80, 0, implicit-def $r1, implicit $r1
    BL @may_throw, csr_xbox360, implicit-def $lr, implicit $rm
    ADJCALLSTACKUP 80, 0, implicit-def $r1, implicit $r1
    B %bb.1
  bb.1.return:
    BLR8 implicit $lr8, implicit $rm
  bb.2.cleanup (landing-pad, ehfunclet-entry):
    $r3 = LI 7
    STW killed $r3, 0, %stack.1
    DBG_VALUE %stack.1, 0, !6, !DIExpression(), debug-location !8
    $r3 = LWZ 0, %stack.1
    STW killed $r3, 0, %stack.0
    $r3 = LWZ 0, %stack.2
    XBOX_CLEANUPRET implicit $lr8, implicit $rm

# CHECK-LABEL: name: large_private_spills
# CHECK: bb.0.entry:
# CHECK: XBOX_STACK_PROBE
# CHECK: bb.2.cleanup
# CHECK: $x0 = frame-setup LIS8 -1
# CHECK: $x0 = frame-setup ORI8 killed $x0, {{[0-9]+}}
# CHECK: $x31 = frame-setup ADD8 $x12, $x0
# CHECK-NOT: XBOX_STACK_PROBE
# CHECK: $x1 = frame-setup STWU8 $x1, -112, $x1
# CHECK: STW killed $r3, 80, $x1
# CHECK: DBG_VALUE $x1, 0, !{{[0-9]+}}, !DIExpression(DW_OP_plus_uconst, 80)
# CHECK: $r3 = LWZ 80, $x1
# CHECK: STW killed $r3, {{[0-9]+}}, $x31
# CHECK: $r3 = LWZ {{[0-9]+}}, $x31
# CHECK: $x1 = ADDI8 $x1, 112
# CHECK: XBOX_CLEANUPRET
...
---
name: dynamic_private_spills
tracksRegLiveness: true
hasEHScopes: true
hasEHFunclets: true
frameInfo:
  adjustsStack: true
  hasCalls: true
  maxCallFrameSize: 80
stack:
  - { id: 0, type: default, size: 4, alignment: 4 }
  - { id: 1, type: spill-slot, size: 4, alignment: 4 }
  - { id: 2, type: variable-sized, alignment: 16 }
  - { id: 3, type: spill-slot, size: 4, alignment: 4 }
body: |
  bb.0.entry:
    successors: %bb.1, %bb.2
    $r3 = LI 5
    STW killed $r3, 0, %stack.3
    ADJCALLSTACKDOWN 80, 0, implicit-def $r1, implicit $r1
    BL @may_throw, csr_xbox360, implicit-def $lr, implicit $rm
    ADJCALLSTACKUP 80, 0, implicit-def $r1, implicit $r1
    B %bb.1
  bb.1.return:
    BLR8 implicit $lr8, implicit $rm
  bb.2.cleanup (landing-pad, ehfunclet-entry):
    $r3 = LI 7
    STW $r3, 0, %stack.0
    STW killed $r3, 0, %stack.1
    $r3 = LWZ 0, %stack.1
    STW killed $r3, 0, %stack.0
    $r3 = LWZ 0, %stack.3
    XBOX_CLEANUPRET implicit $lr8, implicit $rm

# CHECK-LABEL: name: dynamic_private_spills
# CHECK: bb.0.entry:
# CHECK: STD killed $x30, {{-?[0-9]+}}, $x1
# CHECK: $x1 = frame-setup STWU8 $x1, -[[DSIZE:[0-9]+]], $x1
# CHECK: $x30 = frame-setup OR8 $x1, $x1
# CHECK: $x31 = frame-setup OR8 $x1, $x1
# CHECK: bb.1.return:
# CHECK: $x1 = LWZ8 0, $x30
# CHECK: $x30 = frame-destroy LD {{-?[0-9]+}}, $x1
# CHECK: bb.2.cleanup
# CHECK: $x31 = frame-setup ADDI8 $x12, -[[DSIZE]]
# CHECK: STD killed $x30, {{-?[0-9]+}}, $x1
# CHECK: $x1 = frame-setup STWU8 $x1, -[[DPRIVATE:[0-9]+]], $x1
# CHECK: $x30 = frame-setup OR8 $x1, $x1
# CHECK: STW $r3, [[DLOCAL:[0-9]+]], $x31
# CHECK: STW killed $r3, [[DSPILL:[0-9]+]], $x30
# CHECK: $r3 = LWZ [[DSPILL]], $x30
# CHECK: STW killed $r3, [[DLOCAL]], $x31
# CHECK: $r3 = LWZ {{[0-9]+}}, $x31
# CHECK: $x1 = LWZ8 0, $x30
# CHECK: $x30 = frame-destroy LD {{-?[0-9]+}}, $x1
# CHECK: XBOX_CLEANUPRET
...
