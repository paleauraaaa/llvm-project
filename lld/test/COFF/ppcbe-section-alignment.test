# RUN: llvm-readobj --file-headers --sections %t.override.exe | FileCheck %s --check-prefixes=OVERRIDE,PPC4
# RUN: lld-link /entry:main /nodefaultlib /align:65536 /out:%t.inferred-override.exe %t.ppc.obj
# RUN: llvm-readobj --file-headers --sections %t.inferred-override.exe | FileCheck %s --check-prefix=DEFAULT
# RUN: lld-link /entry:main /nodefaultlib /align:4096 /base:0x91000000 /out:%t.base.exe %t.ppc.obj
# RUN: llvm-readobj --file-headers %t.base.exe | FileCheck %s --check-prefix=BASE
# RUN: lld-link /machine:ppcbe /dll /noentry /nodefaultlib /align:4096 /out:%t.dll %t.ppc.obj
# RUN: llvm-readobj --file-headers %t.dll | FileCheck %s --check-prefix=PPC4
