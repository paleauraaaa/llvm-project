# RUN: not lld-link /entry:main /nodefaultlib /align:131072 /out:%t.inferred-invalid.exe %t.ppc.obj 2>&1 | FileCheck %s --check-prefix=INVALID-131072
# RUN: not lld-link /entry:main /nodefaultlib /align:2048 /out:%t.small-invalid.exe %t.ppc.obj 2>&1 | FileCheck %s --check-prefix=INVALID-2048
# RUN: not lld-link /entry:main /nodefaultlib /align:12345 /out:%t.non-power.exe %t.ppc.obj 2>&1 | FileCheck %s --check-prefix=NON-POWER
# RUN: llvm-mc -triple=x86_64-pc-windows-msvc -filetype=obj %t.dir/main.s -o %t.x64.obj
# RUN: lld-link /entry:main /nodefaultlib /out:%t.x64.exe %t.x64.obj
# RUN: llvm-readobj --file-headers --sections %t.x64.exe | FileCheck %s --check-prefixes=OVERRIDE,X64
# RUN: lld-link /entry:main /nodefaultlib /align:8192 /out:%t.x64-override.exe %t.x64.obj
# RUN: llvm-readobj --file-headers --sections %t.x64-override.exe | FileCheck %s --check-prefix=X64-OVERRIDE

# DEFAULT: ImageBase: 0x82000000
# DEFAULT: SectionAlignment: 65536
# DEFAULT: Name: .text
# DEFAULT: VirtualAddress: 0x10000
# DEFAULT: Name: .data
# DEFAULT: VirtualAddress: 0x20000

# PPC4: ImageBase: 0x92000000
# BASE: ImageBase: 0x91000000
# X64: ImageBase: 0x140000000
# OVERRIDE: SectionAlignment: 4096
# OVERRIDE: Name: .text
# OVERRIDE: VirtualAddress: 0x1000
# OVERRIDE: Name: .data
# OVERRIDE: VirtualAddress: 0x2000

# INVALID-8192: error: /align: Xbox 360 images require 4096 or 65536, got 8192
# INVALID-131072: error: /align: Xbox 360 images require 4096 or 65536, got 131072
# INVALID-2048: error: /align: Xbox 360 images require 4096 or 65536, got 2048
# NON-POWER: error: /align: not a power of two: 12345

# X64-OVERRIDE: SectionAlignment: 8192
# X64-OVERRIDE: Name: .text
# X64-OVERRIDE: VirtualAddress: 0x2000
# X64-OVERRIDE: Name: .data
# X64-OVERRIDE: VirtualAddress: 0x4000

#--- main.s
.text
.globl main
main:
  .byte 0
.data
  .byte 1
