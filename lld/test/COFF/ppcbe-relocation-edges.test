# RUN: split-file %s %t.dir
# RUN: yaml2obj %t.dir/pair-addend.yaml -o %t.pair.obj
# RUN: lld-link /machine:ppcbe /entry:main /base:0x10000 /out:%t.pair.exe %t.pair.obj
# RUN: llvm-objdump -s --section=.text %t.pair.exe | FileCheck --check-prefix=PAIR %s
# RUN: yaml2obj %t.dir/pair-invalid.yaml -o %t.pair-invalid.obj
# RUN: not lld-link /machine:ppcbe /entry:main /out:%t.pair-invalid.exe %t.pair-invalid.obj 2>&1 | FileCheck --check-prefix=PAIR-ERROR %s
# RUN: yaml2obj %t.dir/branch-errors.yaml -o %t.branch-errors.obj
# RUN: not lld-link /machine:ppcbe /entry:main /base:0x4000000 /out:%t.branch-errors.exe %t.branch-errors.obj 2>&1 | FileCheck --check-prefix=BRANCH-ERROR %s
# RUN: llvm-mc -filetype=obj -triple=ppc64-ibm-xbox360 %t.dir/secrel16-overflow.s -o %t.secrel16-overflow.obj
# RUN: not lld-link /machine:ppcbe /entry:main /out:%t.secrel16-overflow.exe %t.secrel16-overflow.obj 2>&1 | FileCheck --check-prefix=SECREL16-ERROR %s
# RUN: yaml2obj %t.dir/pair-icf.yaml -o %t.pair-icf.obj
# RUN: lld-link /machine:ppcbe /entry:foo /include:bar /include:baz /opt:icf /base:0x10000 /out:%t.pair-icf.exe %t.pair-icf.obj
# RUN: llvm-objdump -s --section=.text %t.pair-icf.exe | FileCheck --check-prefix=PAIR-ICF %s

# PAIR: 11000 3c60ffff 4e800020

# PAIR-ERROR: IMAGE_REL_PPC_PAIR relocation is not preceded by REFHI
# PAIR-ERROR: IMAGE_REL_PPC_PAIR relocation is not preceded by REFHI

# BRANCH-ERROR: misaligned IMAGE_REL_PPC_REL24 relocation
# BRANCH-ERROR: misaligned IMAGE_REL_PPC_REL14 relocation
# BRANCH-ERROR: misaligned IMAGE_REL_PPC_ADDR24 relocation
# BRANCH-ERROR: misaligned IMAGE_REL_PPC_ADDR14 relocation
# BRANCH-ERROR: IMAGE_REL_PPC_REL24 relocation out of range
# BRANCH-ERROR: IMAGE_REL_PPC_REL14 relocation out of range
# BRANCH-ERROR: IMAGE_REL_PPC_ADDR24 relocation out of range
# BRANCH-ERROR: IMAGE_REL_PPC_ADDR14 relocation out of range

# SECREL16-ERROR: overflow in IMAGE_REL_PPC_SECREL16 relocation

# PAIR-ICF: 11000 3c600000 4e800020 3c60ffff 4e800020

#--- pair-addend.yaml
--- !COFF
header:
  Machine: IMAGE_FILE_MACHINE_PPCBE
  Characteristics: []
sections:
  - Name: .text
    Characteristics: [ IMAGE_SCN_CNT_CODE, IMAGE_SCN_MEM_EXECUTE, IMAGE_SCN_MEM_READ ]
    Alignment: 4
    SectionData: 3C6000004E800020
    Relocations:
      - VirtualAddress: 0
        SymbolName: target
        Type: 16
      - VirtualAddress: 0
        SymbolTableIndex: 65534
        Type: 18
symbols:
  - Name: main
    Value: 0
    SectionNumber: 1
    SimpleType: IMAGE_SYM_TYPE_NULL
    ComplexType: IMAGE_SYM_DTYPE_FUNCTION
    StorageClass: IMAGE_SYM_CLASS_EXTERNAL
  - Name: target
    Value: 4
    SectionNumber: 1
    SimpleType: IMAGE_SYM_TYPE_NULL
    ComplexType: IMAGE_SYM_DTYPE_NULL
    StorageClass: IMAGE_SYM_CLASS_EXTERNAL
...

