//===----------------------------------------------------------------------===//
//
// Declaration-defined signatures use the vector catalog's scalar characters,
// plus b: unsigned char; l/L: long/unsigned long; q/Q: long long/unsigned
// long long; f/d: float/double. ASM is used only by instruction-level operations.
// ICE is a bitmask of immediate argument indices.
//
//===----------------------------------------------------------------------===//

XBOX_PPC_BUILTIN(__emit, "vu", Emit, not_intrinsic, "", 1)
XBOX_PPC_BUILTIN(__loadbyteupdate, "bip", LoadUpdate, not_intrinsic, "lbzux", 0)
