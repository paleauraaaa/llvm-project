//===----------------------------------------------------------------------===//
//
// These builtins have declaration-defined types. Signature characters are:
// V: SDK __vector4; v: void; i/u/h: int/unsigned int/unsigned short;
// e: int or enum; c/C: const/const volatile void *;
// p/P: void/volatile void *; r: unsigned int *.
// The final field is a bitmask of immediate argument indices.
//
//===----------------------------------------------------------------------===//

